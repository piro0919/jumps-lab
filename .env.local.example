# 手元の DB（pnpm db:up で立てる compose.yaml の Postgres）
DATABASE_URL=postgres://jumpslab:jumpslab@localhost:5436/jumpslab

# ログイン（Better Auth）。秘密は `openssl rand -base64 32` で作る
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3110
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry（本番だけ送る。手元では空でよい）
SENTRY_DSN=

# 動画の置き場（Cloudflare R2）。手元は jumps-lab-dev にだけ読み書きできる API トークンの鍵
R2_ENDPOINT=https://0f093da612b2b537a74f4283c2bc0637.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jumps-lab-dev

# AI コーチ（OpenAI）。空なら AI の機能を出さない
OPENAI_API_KEY=

# 管理の画面（/admin）に入れる人の Google のメール。カンマで区切る。空なら誰も入れない
ADMIN_EMAILS=

# 通知（Web Push）。鍵は `pnpm exec next-push keys:generate` で作る。3つ揃わなければ通知の設定を出さない
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://jumpslab.kkweb.io

# 大会前日の通知の Cron（/api/cron/meet-reminder）が確かめる鍵。`openssl rand -base64 32` で作る
CRON_SECRET=

# メール（Resend）。16歳未満の人の保護者へ AI コーチの同意のお願いを送る。MAIL_FROM のドメインは Resend で確かめてから。
# 手元（pnpm dev）で空なら、送らずにリンクをサーバーのログに出す。本番で空なら送らない
RESEND_API_KEY=
MAIL_FROM=

    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-hollow-tests": "0.3.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "secretlint": "^13.1.0",
    "squawk-cli": "2.74.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"

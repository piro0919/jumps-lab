    "@bprogress/next": "3.2.12",
    "@meteocons/svg": "3.0.0-next.10",
    "@piro0919/next-push": "3.0.0",
    "@sentry/nextjs": "^11.14.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.3",
    "better-auth": "1.7.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-ios-pwa-prompt": "2.0.6",
    "react-textarea-autosize": "8.5.9",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "use-pwa": "4.0.0",
    "use-show-window-size": "1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.1.0",
    "@playwright/test": "1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
